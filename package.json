{
  "name": "med-lit",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "main": "expo-router/entry",
  "overrides": {
    "decode-uri-component": "file:vendor/decode-uri-component-compat"
  },
  "scripts": {
    "start": "expo start --localhost",
    "android": "expo start --android --localhost",
    "ios": "expo start --ios --localhost",
    "web": "expo start --web --localhost",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:fetch": "tsx scripts/test-fetch-only.ts",
    "test:ingest": "tsx scripts/test-ingest.ts",
    "test:web-ui": "node scripts/test-web-ui.mjs",
    "test:analyze": "tsx scripts/test-analyze.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:prepare": "tsx scripts/prepare-benchmark.ts",
    "check": "npm run typecheck && npm run test && npm run test:fetch && npm run test:ingest && npm run test:analyze && npm run export:web",
    "release:metadata": "ruby fastlane/validate_metadata.rb",
    "release:prepare:ios": "node scripts/release/check-environment.cjs && expo prebuild --platform ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "decode-uri-component-fixed": "npm:decode-uri-component@0.5.0",
    "expo": "^57.0.0",
    "expo-apple-authentication": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "firebase": "^12.10.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/node": "^22.10.0",
    "@types/react": "~19.2.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  }
}
