rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'photoURL', 'createdAt', 'lastActiveAt',
          'totalAnalyses', 'provider', 'lastAnalysisAt'
        ]);

      match /analyses/{analysisId} {
        allow read, create, update, delete: if owns(uid);
      }

      match /settings/{settingsId} {
        allow read, delete: if owns(uid);
        allow create, update: if owns(uid)
          && settingsId == 'prefs'
          && request.resource.data.keys().hasOnly([
            'aiProvider', 'claudeModel', 'openAiModel', 'geminiModel', 'openRouterModel',
            'unpaywallEmail', 'saveHistory'
          ]);
      }

      // Owners can enumerate legacy records for complete account deletion.
      // The application never creates new legacy records.
      match /history/{entryId} {
        allow read, delete: if owns(uid);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
