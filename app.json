{
  "expo": {
    "name": "MedLit",
    "slug": "med-lit",
    "owner": "redko",
    "version": "1.0.0",
    "description": "Evidence-linked, AI-assisted critical appraisal of biomedical literature. MedLit surfaces study-design questions, source coverage, limitations, and supporting passages without replacing peer review or clinical judgment.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F0EDFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.redko.medlit",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F0EDFF"
      },
      "package": "com.redko.medlit",
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "static",
      "name": "MedLit — Evidence Appraisal Workspace",
      "shortName": "MedLit",
      "description": "Evidence-linked, AI-assisted critical appraisal for biomedical literature.",
      "themeColor": "#5145CD",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-apple-authentication",
      "./plugins/withGoogleModularHeaders.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "medlit",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "cd20c1d0-14cf-4aff-b5c1-eae49e99b307"
      }
    }
  }
}
