# Copy this to .env.local for development. Never commit the populated file.

# Optional Firebase Auth + synced library. Use a dedicated MedLit project.
# Off by default. Provision and audit a separate project before opting in.
# The project ID must start with "medlit-"; both IDs must match exactly.
# Do not reuse the historical shared "med-lit" or a Synaptik project.
EXPO_PUBLIC_ENABLE_MEDLIT_CLOUD=false
EXPO_PUBLIC_MEDLIT_PROJECT_ID=
# Auth domain must be <project-id>.firebaseapp.com.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
EXPO_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=

# Optional opt-in, event-only analytics. Never reuse Synaptik or Gameer tokens.
# Keep disabled until a dedicated project and its capture pipeline are verified.
EXPO_PUBLIC_ENABLE_MEDLIT_ANALYTICS=false
EXPO_PUBLIC_ANALYTICS_PRODUCT=medlit
EXPO_PUBLIC_POSTHOG_PROJECT_ID=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Public canonical origin used by SEO metadata, without a trailing slash.
EXPO_PUBLIC_SITE_URL=http://localhost:8081

# Optional default for the Unpaywall API. Users can set this in the app.
EXPO_PUBLIC_UNPAYWALL_EMAIL=

# Do not put AI-provider keys in Expo environment variables. Users enter their
# own key in Settings; web keys live only for the tab session and native keys
# use encrypted device storage.

# Optional REDKO first-party measurement; separate from Firebase and PostHog.
# No collection without user opt-in. Only one MedLit collector operates at once.
EXPO_PUBLIC_ENABLE_REDKO_LOOP=false
EXPO_PUBLIC_REDKO_LOOP_URL=
EXPO_PUBLIC_REDKO_LOOP_PUBLISHABLE_KEY=

# Public native OAuth client identifiers; never client secrets.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Enable independently only after provider setup and an end-to-end account test.
EXPO_PUBLIC_ENABLE_GOOGLE_SIGN_IN=false
EXPO_PUBLIC_ENABLE_APPLE_SIGN_IN=false
# Show an explicit owner-review banner and suppress indexing on design previews.
EXPO_PUBLIC_REVIEW_BUILD=false

# Public legal identity. Populate only after company/contact verification.
# These values do not change the policies from review drafts to effective terms.
EXPO_PUBLIC_LEGAL_ENTITY=
EXPO_PUBLIC_PRIVACY_CONTACT=
